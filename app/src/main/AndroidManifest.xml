<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- صلاحيات سجل المكالمات -->
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.PROCESS_OUTGOING_CALLS" />

    <!-- صلاحيات التسجيل الصوتي (لازالت مطلوبة لأداة التشخيص اليدوية فقط) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- الوصول لمجلد تسجيلات سامسونج (Recordings/Call) -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- التخزين والرفع -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- منع إزالة التطبيق من غير الأدمن (Device Admin - اختياري، شرح في الدليل) -->
    <uses-permission android:name="android.permission.BIND_DEVICE_ADMIN"
        tools:ignore="ProtectedPermissions" />
        
    <!-- السماح للتطبيق بالظهور فوق التطبيقات الأخرى -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <application
        android:name=".CallMonitorApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:requestLegacyExternalStorage="true"
        android:theme="@style/Theme.CallMonitor"
        android:usesCleartextTraffic="false">

        <!-- أول شاشة: الموافقة الصريحة من الموظف - لازم تتوافق قبل أي صلاحية -->
        <activity
            android:name=".ui.ConsentActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".ui.PermissionsActivity" android:exported="false" />
        <activity android:name=".ui.MainActivity" android:exported="false" />

        <!-- خدمة المراقبة (تذكير + تشغيل مزامنة سامسونج) -->
        <service
            android:name=".service.CallMonitorService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />

        <!-- خدمة إمكانية الوصول: بتكتشف بداية/نهاية المكالمة على الأجهزة
             اللي بتمنع الوصول المباشر لصوت المكالمة -->
        <service
            android:name=".service.CallAccessibilityService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="false">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- مستقبل حالة المكالمة -->
        <receiver android:name=".receiver.CallReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.PHONE_STATE" />
            </intent-filter>
        </receiver>

        <!-- إعادة تشغيل الخدمة بعد إعادة تشغيل الجهاز -->
        <receiver android:name=".receiver.BootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- مراقب حذف ملفات التسجيل -->
        <service
            android:name=".service.FileWatcherService"
            android:exported="false" />

    </application>
</manifest>
