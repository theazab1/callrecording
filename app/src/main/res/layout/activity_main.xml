<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textStyle="bold"
        android:textColor="#333333"
        android:layout_marginBottom="32dp"
        android:textSize="18sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="إعدادات الربط:"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="يرجى إدخال التوكن (API Token) الذي أعطاه لك المدير لتفعيل مراقبة المكالمات."
        android:textSize="14sp"
        android:layout_marginBottom="16dp" />

    <EditText
        android:id="@+id/etApiToken"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="أدخل التوكن هنا"
        android:inputType="textVisiblePassword"
        android:padding="12dp"
        android:background="@android:drawable/edit_text"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnSaveToken"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="حفظ التوكن"
        android:padding="12dp"
        android:backgroundTint="#0d6efd"
        android:textColor="#ffffff"
        android:layout_marginBottom="24dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#dddddd"
        android:layout_marginBottom="24dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="تشخيص المشاكل الصوتية:"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="سجّل 5 ثواني عادية (مش أثناء مكالمة) لمعرفة هل مشكلة الصوت في التطبيق نفسه ولا في قيود المكالمات على الجهاز."
        android:textSize="13sp"
        android:textColor="#555555"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnTestRecording"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ابدأ تسجيل تجريبي (5 ثواني)"
        android:padding="12dp"
        android:backgroundTint="#2e7d32"
        android:textColor="#ffffff" />

    <Button
        android:id="@+id/btnSyncNow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="مزامنة سجل المكالمات + التسجيلات الآن"
        android:padding="12dp"
        android:layout_marginTop="10dp"
        android:backgroundTint="#e65100"
        android:textColor="#ffffff" />

    <TextView
        android:id="@+id/tvTestStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textSize="13sp"
        android:layout_marginTop="12dp" />

</LinearLayout>
