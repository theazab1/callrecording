<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F8F9FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="16dp"
            android:src="@android:drawable/ic_dialog_info"
            android:tint="#0D6EFD"
            android:layout_gravity="center_horizontal"/>

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textStyle="bold"
            android:textColor="#212529"
            android:layout_marginBottom="32dp"
            android:lineSpacingExtra="6dp"
            android:textSize="20sp" />

        <androidx.cardview.widget.CardView
            xmlns:app="http://schemas.android.com/apk/res-auto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#FFFFFF"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="إعدادات الربط الآمن"
                    android:textColor="#0D6EFD"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="يرجى إدخال رمز الربط (API Token) الخاص بك أدناه لربط جهازك بالخادم بنجاح."
                    android:textColor="#6C757D"
                    android:textSize="14sp"
                    android:lineSpacingExtra="4dp"
                    android:layout_marginBottom="20dp" />

                <EditText
                    android:id="@+id/etApiToken"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:hint="أدخل التوكن هنا..."
                    android:inputType="textVisiblePassword"
                    android:paddingHorizontal="16dp"
                    android:background="@android:drawable/editbox_background"
                    android:textSize="15sp"
                    android:layout_marginBottom="24dp" />

                <Button
                    android:id="@+id/btnSaveToken"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:text="حفظ التوكن وتفعيل الربط"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:backgroundTint="#0D6EFD"
                    android:textColor="#ffffff" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            xmlns:app="http://schemas.android.com/apk/res-auto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#FFFFFF"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="أدوات التشخيص والصيانة"
                    android:textColor="#2E7D32"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="سجّل 5 ثواني عادية (مش أثناء مكالمة) لمعرفة هل مشكلة الصوت في التطبيق ولا في قيود المكالمات على الجهاز."
                    android:textColor="#6C757D"
                    android:textSize="13sp"
                    android:layout_marginBottom="16dp" />

                <Button
                    android:id="@+id/btnTestRecording"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:text="ابدأ تسجيل تجريبي (5 ثواني)"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:backgroundTint="#2E7D32"
                    android:textColor="#ffffff" />

                <Button
                    android:id="@+id/btnSyncNow"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:text="مزامنة سجل المكالمات الآن"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="#E65100"
                    android:textColor="#ffffff" />

                <TextView
                    android:id="@+id/tvTestStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="#212529"
                    android:textSize="14sp"
                    android:layout_marginTop="16dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</ScrollView>
